; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

#define MyAppName "ForRocket Workbench"
#define MyAppVersion "1.1.2"
#define MyAppPublisher "import Avio"
#define MyAppURL "https://github.com/sus304/ForRocketWorkbench/"
#define MyAppExeName "ForRocketWorkbench.exe"

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{AA25E8AD-0553-4BCB-90C8-D029B66B5FD8}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={autopf}\{#MyAppName}
DefaultGroupName={#MyAppName}
AllowNoIcons=yes
LicenseFile=C:\cygwin64\home\sus304\ForRocketWorkbench\dist\LICENSE
; Uncomment the following line to run in non administrative install mode (install for current user only.)
;PrivilegesRequired=lowest
OutputDir=.\
OutputBaseFilename=Setup_ForRocketWorkbench
SetupIconFile=C:\cygwin64\home\sus304\ForRocketWorkbench\dist\forrocket_icon.ico
Compression=lzma
SolidCompression=yes
WizardStyle=modern
DisableDirPage=auto
DisableProgramGroupPage=auto

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"
Name: "japanese"; MessagesFile: "compiler:Languages\Japanese.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "C:\cygwin64\home\sus304\ForRocketWorkbench\dist\{#MyAppExeName}"; DestDir: "{app}"; Flags: ignoreversion
Source: "C:\cygwin64\home\sus304\ForRocketWorkbench\dist\ForRocket.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "C:\cygwin64\home\sus304\ForRocketWorkbench\dist\forrocket_icon.ico"; DestDir: "{app}"; Flags: ignoreversion
Source: "C:\cygwin64\home\sus304\ForRocketWorkbench\dist\LICENSE"; DestDir: "{app}"; Flags: ignoreversion
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Icons]
Name: "{group}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{group}\{cm:UninstallProgram,{#MyAppName}}"; Filename: "{uninstallexe}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

